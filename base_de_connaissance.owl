<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:ex="http://example.org#">

    <!-- Classes -->
    <owl:Class rdf:about="http://example.org#Maladie"/>
    <owl:Class rdf:about="http://example.org#Symptome"/>
    <owl:Class rdf:about="http://example.org#Traitement"/>
    <owl:Class rdf:about="http://example.org#Specialiste"/>
    <owl:Class rdf:about="http://example.org#TypeMaladie"/>
    <owl:Class rdf:about="http://example.org#Region"/>
    <owl:Class rdf:about="http://example.org#Prevention"/>

    <!-- Propriétés -->
    <owl:ObjectProperty rdf:about="http://example.org#aSymptome">
        <rdfs:domain rdf:resource="http://example.org#Maladie"/>
        <rdfs:range rdf:resource="http://example.org#Symptome"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org#aTraitement">
        <rdfs:domain rdf:resource="http://example.org#Maladie"/>
        <rdfs:range rdf:resource="http://example.org#Traitement"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org#traitePar">
        <rdfs:domain rdf:resource="http://example.org#Maladie"/>
        <rdfs:range rdf:resource="http://example.org#Specialiste"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="http://example.org#prevalence">
        <rdfs:domain rdf:resource="http://example.org#Maladie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org#ageMoyen">
        <rdfs:domain rdf:resource="http://example.org#Maladie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org#description">
        <rdfs:domain rdf:resource="http://example.org#Symptome"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- Instances -->
    <!-- Maladies -->
    <owl:NamedIndividual rdf:about="http://example.org#Covid19">
        <rdf:type rdf:resource="http://example.org#Maladie"/>
        <ex:aSymptome rdf:resource="http://example.org#Fievre"/>
        <ex:aSymptome rdf:resource="http://example.org#Toux"/>
        <ex:aSymptome rdf:resource="http://example.org#Fatigue"/>
        <ex:aTraitement rdf:resource="http://example.org#Antiviral"/>
        <ex:traitePar rdf:resource="http://example.org#DrSmith"/>
        <ex:prevalence rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.25</ex:prevalence>
        <ex:ageMoyen rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50</ex:ageMoyen>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org#Hypertension">
        <rdf:type rdf:resource="http://example.org#Maladie"/>
        <ex:aSymptome rdf:resource="http://example.org#DouleurTete"/>
        <ex:aTraitement rdf:resource="http://example.org#BetaBloquants"/>
        <ex:traitePar rdf:resource="http://example.org#DrBrown"/>
        <ex:prevalence rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.30</ex:prevalence>
        <ex:ageMoyen rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</ex:ageMoyen>
    </owl:NamedIndividual>

    <!-- Symptômes -->
    <owl:NamedIndividual rdf:about="http://example.org#Fatigue">
        <rdf:type rdf:resource="http://example.org#Symptome"/>
        <rdfs:label xml:lang="fr">Fatigue</rdfs:label>
        <rdfs:label xml:lang="en">Fatigue</rdfs:label>
        <ex:description>Perte d'énergie ou sensation constante de fatigue</ex:description>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org#DouleurTete">
        <rdf:type rdf:resource="http://example.org#Symptome"/>
        <rdfs:label xml:lang="fr">Douleur à la tête</rdfs:label>
        <rdfs:label xml:lang="en">Headache</rdfs:label>
        <ex:description>Pression ou douleur constante au niveau de la tête</ex:description>
    </owl:NamedIndividual>

    <!-- Traitements -->
    <owl:NamedIndividual rdf:about="http://example.org#Antiviral">
        <rdf:type rdf:resource="http://example.org#Traitement"/>
        <rdfs:label xml:lang="fr">Antiviral</rdfs:label>
        <rdfs:label xml:lang="en">Antiviral</rdfs:label>
        <ex:description>Médicament conçu pour réduire les effets d'un virus</ex:description>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org#BetaBloquants">
        <rdf:type rdf:resource="http://example.org#Traitement"/>
        <rdfs:label xml:lang="fr">Bêta-bloquants</rdfs:label>
        <rdfs:label xml:lang="en">Beta-blockers</rdfs:label>
        <ex:description>Médicament pour réduire la tension artérielle</ex:description>
    </owl:NamedIndividual>

    <!-- Spécialistes -->
    <owl:NamedIndividual rdf:about="http://example.org#DrSmith">
        <rdf:type rdf:resource="http://example.org#Specialiste"/>
        <rdfs:label xml:lang="fr">Dr Smith</rdfs:label>
        <rdfs:label xml:lang="en">Dr Smith</rdfs:label>
        <ex:description>Spécialiste des maladies respiratoires</ex:description>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org#DrBrown">
        <rdf:type rdf:resource="http://example.org#Specialiste"/>
        <rdfs:label xml:lang="fr">Dr Brown</rdfs:label>
        <rdfs:label xml:lang="en">Dr Brown</rdfs:label>
        <ex:description>Spécialiste en cardiologie</ex:description>
    </owl:NamedIndividual>
</rdf:RDF>